# Node / pnpm
node_modules/
.pnpm-store/

# Build output
dist/
.next/
out/
*.tsbuildinfo

# Prisma 7 requires an explicit generator output. It is build output, not source:
# `prisma generate` reproduces it, and committing it makes every schema change a
# thousand-line diff. Same path as trekker and Zeus.
nest-api/generated/

# Tests
coverage/

# Environment
.env
.env.*
!.env.example

# The production environment. Holds the database password and the cookie secret in clear, and is
# the file pm2 starts the API with — `ecosystem.config.example.js` is the committed template.
# Same rule as every other app in the fleet.
ecosystem.config.js

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Logs
*.log

# Claude Code — the personal layer only, not the whole directory.
#
# `.claude/` holds three kinds of thing and they do not share a fate: `settings.json` is project
# configuration meant to be shared, `skills/` and `commands/` are work worth keeping, and
# `settings.local.json` is one machine's permission grants and preferences. Ignoring the folder
# wholesale would throw away the first two to hide the third — and would silently drop anything
# added there later.
.claude/settings.local.json
front/.env.production
