# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Production values live in /var/www/iknos/shared/.env on ks-b, chmod 600, outside the
# repository. See DEPLOY.md.

# The database user's rights stop at this schema — Prisma issues DDL and the partition
# maintenance job issues ALTER TABLE ... REORGANIZE PARTITION, but neither outside iknos.*.
# @127.0.0.1 and not @localhost: MySQL treats those as different accounts, and this URL
# connects over TCP.
DATABASE_URL="mysql://iknos:password@127.0.0.1:3306/iknos"

# Scratch space for `prisma migrate dev` only. Absent on ks-b, where `migrate deploy` replays
# migrations and neither diffs nor rebuilds anything.
SHADOW_DATABASE_URL="mysql://iknos:password@127.0.0.1:3306/iknos_shadow"

REDIS_URL="redis://127.0.0.1:6379"

# 4310 in development, 6900 on ks-b — that one is reserved in Zeus's registry and is what the
# vhost proxies to. Keeping them equal would buy nothing.
IKNOS_PORT=4310

IKNOS_LOG_LEVEL=debug

# openssl rand -base64 48
IKNOS_COOKIE_SECRET=""

IKNOS_RETENTION_DAYS=14

IKNOS_PM2_LOG_GLOB="$HOME/.pm2/logs/*.log"

# There is deliberately no variable controlling registration. The instance seals itself once
# the account exists, enforced by a UNIQUE constraint rather than a flag — so there is nothing
# to remember to set, and nothing to switch back on by accident while debugging.
