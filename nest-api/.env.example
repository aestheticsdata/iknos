# Copy to .env and fill in. .env is gitignored; this file is not.
#
# Production values live in /var/www/iknos/shared/.env on ks-b, chmod 600, outside the
# repository. See DEPLOY.md.

# The database user's rights stop at this schema — Prisma issues DDL and the partition
# maintenance job issues ALTER TABLE ... REORGANIZE PARTITION, but neither outside iknos.*.
# @127.0.0.1 and not @localhost: MySQL treats those as different accounts, and this URL
# connects over TCP.
DATABASE_URL="mysql://iknos:password@127.0.0.1:3306/iknos"

# Scratch space for `prisma migrate dev` only. Absent on ks-b, where `migrate deploy` replays
# migrations and neither diffs nor rebuilds anything.
SHADOW_DATABASE_URL="mysql://iknos:password@127.0.0.1:3306/iknos_shadow"

REDIS_URL="redis://127.0.0.1:6379"

# 4310 in development, 6900 on ks-b — that one is reserved in Zeus's registry and is what the
# vhost proxies to. Keeping them equal would buy nothing.
IKNOS_PORT=4310

IKNOS_LOG_LEVEL=debug

# openssl rand -base64 48
IKNOS_COOKIE_SECRET=""

IKNOS_RETENTION_DAYS=14

# Days of raw metric, probe and machine samples kept (IKN-8). Optional, default 3. Its own knob:
# raw metrics run to ~1.4M rows/day per scraped service, and shortening their window must never
# shorten the log window. Long ranges come from the hourly rollups (IKN-20).
# IKNOS_METRIC_RETENTION_DAYS=3

IKNOS_PM2_LOG_GLOB="$HOME/.pm2/logs/*.log"

# --- The mock fleet (IKN-64), dev only ------------------------------------------------------
# `pnpm mock:fleet` runs one dummy process per registry service under its own pm2 daemon, so the
# collector observes only mock data and never this machine's real ~/.pm2. Both lines are required
# for it (the fleet refuses to start without them), and `fs.glob` does not expand `$HOME` — write
# the absolute path. Restart `pnpm dev` after changing them: the API reads .env at boot.
# IKNOS_PM2_LOG_GLOB="/Users/you/.iknos-mock/pm2/logs/*.log"
# PM2_HOME="/Users/you/.iknos-mock/pm2"
# With nineteen scraped services, raw samples run to ~1M rows/day — one day of them is plenty on
# a laptop, and IKNOS_RETENTION_DAYS=7 matches the corpus's own window.
# IKNOS_METRIC_RETENTION_DAYS=1

# --- Explicit HTTP ingestion (IKN-29) — both optional ---------------------------------------
#
# What browsers present on POST /api/ingest. Unset, that route answers 503 and nothing else
# changes: it is the one variable here whose absence is a working configuration.
#
# It ships inside a JavaScript bundle, so it is NOT a secret — it names a sender, the way
# Sentry's DSN key does. What actually protects the route is the service registry, the origin
# list below, and a rate limit.
#
# openssl rand -base64 24
IKNOS_INGEST_TOKEN=""

# Comma-separated. Only ever checked against requests that sent an Origin header, so leaving it
# empty still lets curl and server-side senders through — it simply stops distinguishing
# browsers.
IKNOS_INGEST_ORIGINS=""

# There is deliberately no variable controlling registration. The instance seals itself once
# the account exists, enforced by a UNIQUE constraint rather than a flag — so there is nothing
# to remember to set, and nothing to switch back on by accident while debugging.
