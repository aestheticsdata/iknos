// Iknos' data model. See docs/superpowers/specs/2026-08-10-iknos-nestjs-api-design.md §4.
//
// Four models only — everything M1 needs to put a log line on screen. The rest arrives with
// the feature that needs it, as additive migrations: the recovery passphrase column with
// Task 11, the metric and host tables with M2, issues with IKN-9. Alerts arrive with IKN-10.
//
// Layout, generator settings and output path are trekker's and Zeus's, unchanged.

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "mysql"
}

/// The registry of monitored applications. This is what makes the tool reusable without a
/// redeploy: adding an app is a row, not a code change.
model Service {
  id Int @id @default(autoincrement())

  /// What the interface calls it, and the value `log_entry.service` carries — the tailer derives
  /// that from the PM2 log filename, so for anything PM2 runs the two are the same string. A
  /// friendlier label here would be a rail whose every entry filters on a value no log has.
  name String @unique @db.VarChar(64)

  /// What PM2 calls it. Equal to `name` for every row today; the column exists for the sources
  /// that are not PM2 processes at all — nginx arrives with IKN-16 and has no PM2 name to give.
  pm2Name String @map("pm2_name") @db.VarChar(64)

  metricsUrl String? @map("metrics_url") @db.VarChar(255)
  healthUrl  String? @map("health_url") @db.VarChar(255)
  logGlob    String? @map("log_glob") @db.VarChar(512)

  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  @@map("service")
}

/// The single account. `user` is reserved in MySQL 8, hence `app_user`.
model AppUser {
  id Int @id @default(autoincrement())

  /// Always true. UNIQUE on it is what makes "there is exactly one account" a guarantee the
  /// database enforces, rather than a `count() === 0` the register route hopes it won the race
  /// for. Copied from Zeus, which reached the same shape for the same reason.
  ///
  /// It is here in the first migration and not with Task 11 because the CLI arrives in Task 10,
  /// before registration — and a CLI that could create the second account would make this
  /// constraint impossible to add afterwards.
  singleton Boolean @unique @default(true)

  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  /// The only way back in. ks-b has no mail server and is not getting one, so there is no reset
  /// link to send — the passphrase chosen at registration is the whole recovery story.
  ///
  /// Hashed independently of the password, with the same KDF: the passphrase can reset the
  /// password, so knowing one must never reveal the other.
  ///
  /// Nullable, and that is the point of it being added here rather than in the first migration:
  /// an account created by `pnpm seed:user` before this column existed keeps working, and simply
  /// has no way back.
  recoveryPassphraseHash String? @map("recovery_passphrase_hash") @db.VarChar(255)

  @@map("app_user")
}

/// Where the tailer got to in each file. `(dev, inode)` is how rotation is detected: a new
/// inode means the file was replaced and reading restarts at zero.
model IngestOffset {
  filePath String @id @map("file_path") @db.VarChar(512)

  dev   BigInt @db.UnsignedBigInt
  inode BigInt @db.UnsignedBigInt

  /// `byte_offset`, never `offset` — OFFSET is reserved in MySQL 8.0.
  byteOffset BigInt @map("byte_offset") @db.UnsignedBigInt

  updatedAt DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("ingest_offset")
}

/// One log line. Partitioned by day — see the hand-written clause in the initial migration,
/// which Prisma cannot express and will not round-trip.
///
/// No FULLTEXT index: InnoDB forbids one on a partitioned table. That trade is deliberate and
/// argued in §4.2 of the backend spec — partitioning buys instant retention that returns disk,
/// and literal search that actually finds paths, UUIDs and trace ids.
model LogEntry {
  id BigInt   @default(autoincrement()) @db.UnsignedBigInt
  ts DateTime @db.DateTime(3)

  service   String  @db.VarChar(64)
  level     Int     @db.SmallInt
  levelName String  @map("level_name") @db.VarChar(16)
  logger    String? @db.VarChar(128)
  message   String  @db.Text

  traceId String? @map("trace_id") @db.Char(32)

  httpMethod String? @map("http_method") @db.VarChar(10)
  route      String? @db.VarChar(255)
  statusCode Int?    @map("status_code") @db.SmallInt
  durationMs Int?    @map("duration_ms")

  /// 45 characters: an IPv4-mapped IPv6 address is the longest form that fits.
  clientIp String? @map("client_ip") @db.VarChar(45)

  userId   String? @map("user_id") @db.VarChar(64)
  hostname String? @db.VarChar(128)

  /// Everything the columns above do not claim.
  attrs Json?

  /// Composite, and in this order. MySQL requires every unique key of a partitioned table to
  /// contain the partitioning column; InnoDB requires the AUTO_INCREMENT column to lead an
  /// index. `(id, ts)` is the only shape that satisfies both.
  @@id([id, ts])
  @@index([service, ts])
  @@index([level, ts])
  @@index([traceId, ts])
  @@index([route, ts])
  @@map("log_entry")
}

/// One scraped Prometheus sample (IKN-8). Histogram series are stored as their raw `_bucket`,
/// `_sum` and `_count` parts, untouched: a correct p95 is recomputed later by interpolating on
/// the buckets, the way `histogram_quantile` does. Collapsing them at scrape time would throw
/// that information away for good.
///
/// Partitioned by day like `log_entry` — see the hand-written clause in this table's migration.
model MetricSample {
  id BigInt   @default(autoincrement()) @db.UnsignedBigInt
  ts DateTime @db.DateTime(3)

  service String @db.VarChar(64)
  name    String @db.VarChar(128)

  /// The label set as scraped, sorted by key. Null when the series has no labels.
  labels Json?

  /// Stable hash of the sorted label set — the indexable identity of a series. Indexing JSON
  /// would be both slower and collation-dependent; sixteen hex characters are neither.
  labelsHash String @map("labels_hash") @db.Char(16)

  value Float

  @@id([id, ts])
  @@index([service, name, labelsHash, ts])
  @@map("metric_sample")
}

/// Hourly aggregates of `metric_sample`, filled by IKN-20. The table exists from IKN-8 so the
/// raw table and its rollup are created by the same migration and partitioned the same way —
/// a thirty-day chart cannot be answered from raw points without becoming slow exactly when it
/// becomes interesting.
model MetricRollup {
  id BigInt   @default(autoincrement()) @db.UnsignedBigInt
  ts DateTime @db.DateTime(3)

  service    String @db.VarChar(64)
  name       String @db.VarChar(128)
  labels     Json?
  labelsHash String @map("labels_hash") @db.Char(16)

  count Int
  sum   Float
  min   Float
  max   Float
  last  Float

  @@id([id, ts])
  @@unique([service, name, labelsHash, ts])
  @@map("metric_rollup")
}

/// One health probe result (IKN-8). A failed probe is a row, never an exception: unreachable is
/// exactly the fact the table exists to record.
model HealthCheck {
  id BigInt   @default(autoincrement()) @db.UnsignedBigInt
  ts DateTime @db.DateTime(3)

  service String @db.VarChar(64)

  /// The HTTP status the probe got, or null when no response came back at all.
  httpStatus Int?    @map("http_status") @db.SmallInt
  ok         Boolean
  latencyMs  Int?    @map("latency_ms")
  error      String? @db.VarChar(255)

  /// The per-dependency breakdown from the probed body (`{ db: { status, latencyMs }, ... }`),
  /// kept whole: the `mysql 3ms` / `redis 1ms` pills need the parts, not an aggregate.
  checks Json?

  /// The version the probed service reports about itself — from its release marker, or absent.
  version String? @db.VarChar(64)

  @@id([id, ts])
  @@index([service, ts])
  @@map("health_check")
}

/// One reading of the machine (IKN-8, consumed by IKN-25). CPU is a delta between consecutive
/// samples, so the first sample after boot honestly has none.
model HostSample {
  id BigInt   @default(autoincrement()) @db.UnsignedBigInt
  ts DateTime @db.DateTime(3)

  cpuPct Float? @map("cpu_pct")
  load1  Float
  load5  Float
  load15 Float

  memUsedBytes  BigInt @map("mem_used_bytes") @db.UnsignedBigInt
  memTotalBytes BigInt @map("mem_total_bytes") @db.UnsignedBigInt

  diskUsedBytes  BigInt? @map("disk_used_bytes") @db.UnsignedBigInt
  diskTotalBytes BigInt? @map("disk_total_bytes") @db.UnsignedBigInt

  @@id([id, ts])
  @@index([ts])
  @@map("host_sample")
}

/// One `pm2 jlist` reading per process (IKN-8). Feeds the service header chips: pm2 id, node
/// version, uptime, restart count. `startedAt` rather than a computed uptime — the reading does
/// not age, the arithmetic happens at display time.
model ProcessSample {
  id BigInt   @default(autoincrement()) @db.UnsignedBigInt
  ts DateTime @db.DateTime(3)

  pm2Name String @map("pm2_name") @db.VarChar(64)
  pm2Id   Int?   @map("pm2_id")
  status  String @db.VarChar(16)

  restarts Int
  cpuPct   Float?  @map("cpu_pct")
  memBytes BigInt? @map("mem_bytes") @db.UnsignedBigInt

  startedAt   DateTime? @map("started_at") @db.DateTime(3)
  nodeVersion String?   @map("node_version") @db.VarChar(16)

  @@id([id, ts])
  @@index([pm2Name, ts])
  @@map("process_sample")
}

/// One grouped error — IKN-9. The "Sentry-like" half of the project: an exception that falls four
/// hundred times is one problem, not four hundred lines to read.
///
/// **Unpartitioned, and kept indefinitely.** Its occurrences are a stream under retention
/// (`issue_event`); the identity is not. An issue whose last occurrence has aged out still answers
/// "when did this first appear", which is the column the view exists for.
model Issue {
  id Int @id @default(autoincrement())

  /// Sixteen hex characters over service + error type + the top normalised frames. UNIQUE, and
  /// that is what makes "one issue per fingerprint" a guarantee the database enforces rather than
  /// a read-then-write two concurrent collector batches can both win — the `app_user.singleton`
  /// argument, applied to a second invariant. Built by `src/issues/fingerprint.ts`; changing that
  /// function is a data migration.
  fingerprint String @unique @db.Char(16)

  service String  @db.VarChar(64)
  type    String? @db.VarChar(255)
  message String  @db.Text

  /// The first frame that is ours, already normalised — `acquire (dist/queue/export.js:142)`.
  /// Null when every frame belongs to a dependency: naming the library says nothing the type did
  /// not already say.
  culprit String? @db.VarChar(255)

  level     Int    @db.SmallInt
  levelName String @map("level_name") @db.VarChar(16)

  /// `unresolved` | `resolved` | `ignored` — the mockup's own words, carried down to the column.
  /// A column named `open` and a filter labelled "unresolved" eventually produce a filter that
  /// does not filter. VarChar and not an enum: the schema has none.
  status String @default("unresolved") @db.VarChar(16)

  /// Set when a resolved issue recurs. Its own flag rather than a fourth status, so a regression
  /// stays inside the `unresolved` filter — which is the filter it most belongs in.
  regression Boolean @default(false)

  /// Written at creation and never touched again. The view shows it as "since when", and a value
  /// that slides makes that column useless.
  firstSeen DateTime @map("first_seen") @db.DateTime(3)
  lastSeen  DateTime @map("last_seen") @db.DateTime(3)

  /// Every occurrence, including those the per-minute cap kept out of `issue_event`. The count is
  /// exact; the samples are capped.
  eventCount Int @map("event_count") @default(0)

  /// Captured from the deploy's release marker when the service has one, at the first and last
  /// occurrence. Null rather than fabricated from anything else, and the column shows `—`.
  firstRelease String? @map("first_release") @db.VarChar(64)
  lastRelease  String? @map("last_release") @db.VarChar(64)

  /// The latest occurrence's stack and context, for the modal — kept on the issue so a stack
  /// survives its events being pruned.
  sample Json?

  @@index([service, lastSeen])
  @@index([status, lastSeen])
  @@map("issue")
}

/// One occurrence of an issue — IKN-9. What the 48h chart and the panel's sparkline count.
///
/// Partitioned by day and pruned like `log_entry`: this is a stream, and an error in a render loop
/// would otherwise fill the disk. `issueId` is a plain indexed column, not a relation — the schema
/// has no foreign keys, and InnoDB would refuse one on a partitioned table anyway.
///
/// **There is no `log_id`.** `persistBatch` writes through `createMany` inside `$transaction`,
/// which returns no generated ids on MySQL, so the column would be NULL on every row the collector
/// wrote. The pointer back to the log line is `(ts, service, traceId)`, which is what the
/// correlated-logs link needs anyway — `GET /api/logs` refuses a request without bounds.
model IssueEvent {
  id BigInt   @default(autoincrement()) @db.UnsignedBigInt
  ts DateTime @db.DateTime(3)

  issueId Int    @map("issue_id")
  service String @db.VarChar(64)

  traceId String? @map("trace_id") @db.Char(32)

  /// `release_tag`, never `release` — RELEASE is reserved in MySQL 8.0, and every hand-written
  /// statement in this codebase writes bare, unquoted column names. Same rule as `byte_offset`.
  releaseTag String? @map("release_tag") @db.VarChar(64)

  message String  @db.Text
  stack   String? @db.Text
  attrs   Json?

  /// How many occurrences this sample stands for — the pass's count for its fingerprint, not 1.
  ///
  /// The grouper writes at most one row per fingerprint per pass, so a row is a *sample* and the
  /// number of rows says how many passes saw the error, never how often it threw. The sparkline
  /// and the 48 h chart are supposed to show the second thing, so the number travels with the
  /// sample: `SUM(count)` over a bucket is the real volume, `COUNT(*)` would be a flat line four
  /// bars high whether the error threw four times a minute or four thousand.
  ///
  /// It is the same trade `issue.event_count` makes and it stays consistent with it: summed over
  /// the whole retention window these add up to `event_count`, minus whatever the per-minute cap
  /// refused — which at a 15 s interval and a ceiling of twenty is nothing.
  count Int @default(1)

  @@id([id, ts])
  @@index([issueId, ts])
  @@index([service, ts])
  @@map("issue_event")
}
