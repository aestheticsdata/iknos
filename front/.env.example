# Template for `front/.env.production`, which is NOT committed. Copy this file, fill it in, and
# keep the real one on the machine that deploys.
#
#   cp .env.example .env.production
#
# Everything here is `NEXT_PUBLIC_`, so Next inlines it into the JavaScript bundle at build time.
# `deploy-front.sh` builds on ks-b and the rsync excludes only `.env`, so the real file travels
# with the sources without ever entering git.
#
# Empty values mean browser error reporting is simply off, which is the state a fresh checkout is
# in. Off costs nothing: with an empty token the reporter's guard folds to `false` at build time
# and the minifier drops the whole module — no `X-Iknos-Token` and no `/api/ingest` anywhere in
# the client bundle.

# Same origin: nginx routes /api/ to the API, and `next.config.js` rewrites it in development.
# Never the loopback address — this call is made by a browser, not by the server.
NEXT_PUBLIC_IKNOS_INGEST_URL="/api/ingest"

# Must exist and be enabled in the `service` table, or the API answers 400.
NEXT_PUBLIC_IKNOS_SERVICE="iknos-front"

# Generate with `openssl rand -base64 24`, and set the identical value as `IKNOS_INGEST_TOKEN` in
# `nest-api/ecosystem.config.js`. The API's copy is the one actually checked.
#
# Published to every visitor inside the bundle, so it identifies a sender rather than
# authenticating one — the guards that hold are the service registry, the origin allowlist and the
# rate limit, all of them API-side.
NEXT_PUBLIC_IKNOS_INGEST_TOKEN=""
