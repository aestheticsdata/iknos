# Build-time configuration for the production build (IKN-29).
#
# Committed on purpose, unlike `nest-api/ecosystem.config.js`. Everything here is `NEXT_PUBLIC_`,
# which means Next inlines it into the JavaScript bundle at build time — these values are
# published to every visitor by definition, so keeping them out of git would protect nothing and
# only make a deploy depend on a file nobody can find. Same reasoning as a Sentry DSN.
#
# `deploy-front.sh` builds on ks-b, so this file has to travel with the sources. It does: only
# `.env` is excluded from the rsync.
#
# Empty values mean error reporting is simply off, which is the state the front ships in. To turn
# it on, set the token here AND set the identical value as `IKNOS_INGEST_TOKEN` in ks-b's
# `nest-api/ecosystem.config.js` — the two have to match, and the API's copy is the one that is
# actually checked.
#
# Off costs nothing at all, and that is measured rather than assumed: with an empty token the
# reporter's guard folds to `false` at build time and the minifier removes the whole module — no
# `X-Iknos-Token` and no `/api/ingest` appear anywhere in the client bundle. Set the token and
# they do.
#
#   openssl rand -base64 24

# Same origin: nginx routes /api/ to the API, and `next.config.js` rewrites it in development.
# Never the loopback address — this call is made by a browser, not by the server.
NEXT_PUBLIC_IKNOS_INGEST_URL="/api/ingest"

# Must exist and be enabled in the `service` table, or the API answers 400.
NEXT_PUBLIC_IKNOS_SERVICE="iknos-web"

NEXT_PUBLIC_IKNOS_INGEST_TOKEN=""
